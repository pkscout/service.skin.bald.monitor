<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="service.skin.bald.monitor" name="Skin.Bald Update Monitor" version="0.1.0" provider-name="pkscout">
    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
    </requires>
    <extension point="xbmc.service" library="service.py"/>
    <extension point="xbmc.addon.metadata">
        <summary>Monitors for updates to skin.bald</summary>
        <description>Adds back the custom colors if Bald is updated.</description>
        <platform>all</platform>
    </extension>
</addon>